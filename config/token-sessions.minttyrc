# mintty settings for the "Claude Sessions" window.
#
# The shortcut points at this file with -c, so the window can be retuned by
# editing text rather than by opening shortcut properties - and nothing here
# touches your ordinary Git Bash windows, which keep their own settings.
#
# Edit, save, reopen the shortcut. No other step.

# The font. Was Lucida Console 9 (mintty's default, which is what the window
# picked up when nothing specified one). Consolas is a denser face at the same
# nominal size, so this is two steps smaller in practice.
Font=Consolas
FontHeight=10
FontSmoothing=default

# Rows matter more than columns here and are the thing that was actually short:
# the pane redraws in place and cannot scroll, so the analytics tab pages to fit
# whatever height it is given, and every row it gains is a section it no longer
# has to put on page two.
#
# Rows is only the fallback now. The shortcut passes -s maxheight, which sets
# the window to as many rows as the screen will hold - so the height follows the
# font rather than fighting it, and a bigger FontHeight costs rows automatically
# instead of pushing the bottom of the window off the desktop. Change the font
# above and the row count re-derives itself; nothing here needs touching.
#
# Columns past ~120 only widen the name and growth columns, and both self-cap
# (the session table stops at a 30-column name, analytics at 104), so this is
# not wider still because past this point the extra columns are a gap.
Columns=140
Rows=48

# The palette assumes a dark terminal - green means nothing to do, red means
# money on the floor, and neither reads on a light background. Set explicitly
# rather than inherited, so the window looks the same wherever it is opened.
BackgroundColour=16,18,22
ForegroundColour=205,210,216
CursorColour=120,170,170
Transparency=off

# No scrollback: the pane owns the alternate screen and repaints every frame,
# so a scrollbar is a control that can never do anything.
ScrollbackLines=0
Scrollbar=none
ConfirmExit=no
