<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon only (Tray.cs); its implicit usings would make Application, Button and friends ambiguous -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\token-chat.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TokenChat.Core\TokenChat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RemoteServer.cs: Kestrel for the LAN page (HttpListener off localhost needs an admin urlacl) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Remote\index.html" LogicalName="remote.index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MdXaml" Version="1.27.0" />
  </ItemGroup>

</Project>
