<Window x:Class="TokenChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TokenChat.App"
        Title="token-chat" Width="1310" Height="800" UseLayoutRounding="True"
        Background="{StaticResource Card}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Ui}" FontSize="13">
    <!-- The widget's chrome: no system title bar. The band along the top drags the window; snap, resize and
         double-click-to-maximise stay native. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Maximised, a chrome window hangs its resize border off the screen; pad it back in. -->
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource Track}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- every session, this window's first: the sidebar is how a session is picked, opened and closed -->
            <local:SidebarView x:Name="Side"/>
            <Border Grid.Column="1" Width="1" Background="{StaticResource Line}"/>

            <!-- the selected session's chat, below the caption band and its rule -->
            <Border Grid.Column="2" Height="1" VerticalAlignment="Top" Margin="0,34,0,0" Background="{StaticResource Line}"/>
            <ContentControl x:Name="Chat" Grid.Column="2" Margin="0,35,0,0" Focusable="False">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <local:SessionView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- the sidebar's analytics row: over the chat, which keeps its session for the next row click -->
            <local:AnalyticsView x:Name="Analytics" Grid.Column="2" Margin="0,35,0,0" Visibility="Collapsed"/>

            <!-- no session open, or "+": recent folders over the content area, below the caption -->
            <local:StartView x:Name="Start" Grid.Column="2" Margin="0,35,0,0" Visibility="Collapsed"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Height="34" Margin="0,0,4,0">
                <Button Content="&#8211;" Style="{StaticResource Glyph}" FontSize="12" ToolTip="minimise" Click="OnMinimise"/>
                <Button x:Name="MaxGlyph" Content="&#9633;" Style="{StaticResource Glyph}" FontSize="12" ToolTip="maximise" Click="OnMaximise"/>
                <Button Content="&#10005;" Style="{StaticResource GlyphClose}" ToolTip="close" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
