<Window x:Class="TokenChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TokenChat.App"
        Title="token-chat" Width="1310" Height="800" UseLayoutRounding="True"
        Background="{StaticResource Card}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Ui}" FontSize="13">
    <!-- The widget's chrome: no system title bar, the tabs are the caption. The strip between and
         beside the tabs drags the window; snap, resize and double-click-to-maximise stay native. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A browser's tabs, as on the widget: the one showing takes a ground a step up from the card
             and a hairline edge that runs into the rule below; the rest are their title, dimmed. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- the project's colour along the top edge, inset clear of the rounded corners -->
                        <Grid Cursor="Hand" Margin="0,0,3,0">
                            <Border x:Name="B" CornerRadius="6,6,0,0" BorderThickness="1,1,1,0" Padding="8,5,4,6"
                                    Background="{StaticResource Ghost}" BorderBrush="{StaticResource Ghost}">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <Border Height="3" VerticalAlignment="Top" Margin="6,0" CornerRadius="0,0,1.5,1.5"
                                    Background="{Binding ProjectBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource Sel}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Track}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <!-- right margin keeps the tabs clear of the glyphs laid over this row -->
                            <TabPanel IsItemsHost="True" Margin="8,0,170,0" VerticalAlignment="Bottom"/>
                            <Border Grid.Row="1" Height="1" Background="{StaticResource Line}"/>
                            <ContentPresenter Grid.Row="2" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Maximised, a chrome window hangs its resize border off the screen; pad it back in. -->
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource Track}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- every session, this window first; the tabs stay until the sidebar takes over switching (phase 3) -->
            <local:SidebarView x:Name="Side"/>
            <Border Grid.Column="1" Width="1" Background="{StaticResource Line}"/>

            <TabControl x:Name="Tabs" Grid.Column="2" BorderThickness="0" Background="Transparent">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SessionTab}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Options.WorkingDirectory}">
                            <TextBlock x:Name="Dot" Text="&#9679;" FontSize="9" Margin="0,2,7,0"
                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="&#10005;" Style="{StaticResource GlyphClose}" FontSize="9" Padding="8,0,4,0"
                                    ToolTip="close the session" Click="OnCloseTab"/>
                        </StackPanel>
                        <!-- the dot says what the session is doing, as the widget's row dots do -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="idle">
                                <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource Green}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="working">
                                <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource Blue}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="exited">
                                <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource Red}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <local:SessionView/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- no tab open, or "+": recent folders over the content area, below the caption -->
            <local:StartView x:Name="Start" Grid.Column="2" Margin="0,35,0,0" Visibility="Collapsed"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Height="34" Margin="0,0,4,0">
                <CheckBox x:Name="LiteBox" Content="lite" Style="{StaticResource TextToggle}" Margin="0,1,2,0"
                          ToolTip="new tabs start Lite: Read, Edit, Write, Bash, Grep, Glob, AskUserQuestion; no MCP (about 16.9k floor)"/>
                <Button Content="+" Style="{StaticResource Glyph}" FontFamily="{StaticResource Ui}" FontSize="16"
                        Padding="7,0,7,2" ToolTip="new tab…" Click="OnNewTab"/>
                <Border Width="1" Height="14" Background="{StaticResource Line}" Margin="6,0"/>
                <Button Content="&#8211;" Style="{StaticResource Glyph}" FontSize="12" ToolTip="minimise" Click="OnMinimise"/>
                <Button x:Name="MaxGlyph" Content="&#9633;" Style="{StaticResource Glyph}" FontSize="12" ToolTip="maximise" Click="OnMaximise"/>
                <Button Content="&#10005;" Style="{StaticResource GlyphClose}" ToolTip="close" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
